<UserControl x:Class="HyperMoeland.Views.ExpandedCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:HyperMoeland.Views">
    <UserControl.Resources>
        <!-- 媒体控制按钮：透明底、主题色、悬停/按下反馈 -->
        <Style x:Key="MediaControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Foreground}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Theme.Overlay}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{DynamicResource Theme.Border}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 媒体控制图标（矢量，避免 Unicode 符号在部分字体下乱码） -->
        <Geometry x:Key="HeartPath">M12,21 C7,16.5 2,12 2,7.5 C2,4.5 4.5,2 7.5,2 C9.5,2 11,3 12,4.5 C13,3 14.5,2 16.5,2 C19.5,2 22,4.5 22,7.5 C22,12 17,16.5 12,21 Z</Geometry>
        <Geometry x:Key="PrevPath">M3,5 H6 V19 H3 Z M19,5 L7,12 L19,19 Z</Geometry>
        <Geometry x:Key="PlayPath">M8,5 L20,12 L8,19 Z</Geometry>
        <Geometry x:Key="PausePath">M7,5 H10 V19 H7 Z M14,5 H17 V19 H14 Z</Geometry>
        <Geometry x:Key="NextPath">M5,5 L17,12 L5,19 Z M18,5 H21 V19 H18 Z</Geometry>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            CornerRadius="28"
            BorderThickness="1"
            Background="{DynamicResource Theme.Overlay}"
            BorderBrush="{DynamicResource Theme.Border}"
            MouseLeftButtonDown="OnMouseLeftButtonDown">

        <Grid>
            <!-- 霓虹背景：下半部发光，播放音乐时按节奏在几组固定配色间交叉淡入淡出。
                 配色层采用"预渲染的抖动位图"（加入少量随机噪声打破 8bit 渐变带），
                 既能消除低透明度渐变的摩尔纹/色带，也能缓存为静态图，只做层间透明度合成。 -->
            <Border x:Name="NeonBack"
                    CornerRadius="28"
                    Visibility="Collapsed"
                    Opacity="0.4"
                    ClipToBounds="True">
                <Grid>
                    <Border x:Name="NeonLayer0" CornerRadius="28" Opacity="1" />
                    <Border x:Name="NeonLayer1" CornerRadius="28" Opacity="0" />
                    <Border x:Name="NeonLayer2" CornerRadius="28" Opacity="0" />
                </Grid>
            </Border>
            <!-- 时钟视图（无媒体，紧凑卡片） -->
            <StackPanel x:Name="ClockView"
                        Margin="24"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock x:Name="TimeText"
                           FontSize="40"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Foreground}"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="DateText"
                           FontSize="14"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource Theme.Muted}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="202" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                    <Path x:Name="ChargingIcon"
                          Data="M13,2 L5,13 H11 L9,22 L19,9 H12 Z"
                          Fill="#FF00C27A"
                          Width="14"
                          Height="16"
                          Stretch="Uniform"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="Collapsed">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="ChargingScale" ScaleX="1" ScaleY="1" />
                        </Path.RenderTransform>
                    </Path>
                    <TextBlock x:Name="BatteryText"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Muted}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <!-- 系统小组件：CPU / 内存（可在设置中关闭） -->
                <views:SystemWidgets x:Name="Widgets"
                                     Margin="0,14,0,0"
                                     Visibility="Collapsed" />
                <TextBlock x:Name="NotificationText"
                           FontSize="13"
                           Margin="0,10,0,0"
                           Foreground="{DynamicResource Theme.Foreground}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- 媒体面板（对齐参考图）：封面+标题/歌手 + 控制按钮行 + 时间/进度/时间 -->
            <StackPanel x:Name="MediaArea"
                        Margin="24"
                        Visibility="Collapsed">
                <!-- 封面（左上）+ 标题 / 歌手（右侧） -->
                <StackPanel Orientation="Horizontal">
                    <Border Width="90"
                            Height="90"
                            CornerRadius="18"
                            Background="{DynamicResource Theme.Border}">
                        <Border.Clip>
                            <RectangleGeometry RadiusX="18" RadiusY="18" Rect="0,0,90,90" />
                        </Border.Clip>
                        <Image x:Name="CoverImage"
                               Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                MaxWidth="320">
                        <TextBlock x:Name="MediaTitle"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Theme.Foreground}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap" />
                        <TextBlock x:Name="MediaArtist"
                                   FontSize="14"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Theme.Muted}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>

                <!-- 控制按钮行：♥ ⏮ ⏸/▶ ⏭（横排铺满） -->
                <Grid x:Name="MediaControls"
                      Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="LikeButton"
                            Style="{StaticResource MediaControlButton}"
                            Grid.Column="0"
                            ToolTip="喜欢"
                            Click="OnLikeClicked">
                        <Path x:Name="LikeIcon"
                              Data="{StaticResource HeartPath}"
                              Fill="{DynamicResource Theme.Foreground}"
                              Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="PreviousButton"
                            Style="{StaticResource MediaControlButton}"
                            Grid.Column="1"
                            ToolTip="上一首"
                            Click="OnPreviousClicked">
                        <Path Data="{StaticResource PrevPath}"
                              Fill="{DynamicResource Theme.Foreground}"
                              Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="PlayPauseButton"
                            Style="{StaticResource MediaControlButton}"
                            Grid.Column="2"
                            ToolTip="播放 / 暂停"
                            Click="OnPlayPauseClicked">
                        <Path x:Name="PlayPauseIcon"
                              Data="{StaticResource PausePath}"
                              Fill="{DynamicResource Theme.Foreground}"
                              Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                    <Button x:Name="NextButton"
                            Style="{StaticResource MediaControlButton}"
                            Grid.Column="3"
                            ToolTip="下一首"
                            Click="OnNextClicked">
                        <Path Data="{StaticResource NextPath}"
                              Fill="{DynamicResource Theme.Foreground}"
                              Width="22" Height="22" Stretch="Uniform" />
                    </Button>
                </Grid>

                <!-- 进度行：00:06 ──●──── 00:45 -->
                <Grid x:Name="ProgressRow"
                      Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MediaTimePos"
                               Text="00:00"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Muted}"
                               VerticalAlignment="Center"
                               Grid.Column="0" />
                    <Grid x:Name="ProgressTrack"
                          Height="4"
                          Margin="12,0"
                          VerticalAlignment="Center"
                          Grid.Column="1"
                          Background="Transparent"
                          Cursor="Hand"
                          MouseLeftButtonDown="OnProgressTrackMouseLeftButtonDown"
                          Visibility="Collapsed">
                        <Border Background="{DynamicResource Theme.Border}"
                                CornerRadius="2" />
                        <Rectangle x:Name="MediaProgressFill"
                                   Fill="{DynamicResource Theme.Foreground}"
                                   RadiusX="2"
                                   RadiusY="2"
                                   HorizontalAlignment="Left"
                                   Width="0" />
                    </Grid>
                    <TextBlock x:Name="MediaTimeDur"
                               Text="00:00"
                               FontSize="12"
                               Foreground="{DynamicResource Theme.Muted}"
                               VerticalAlignment="Center"
                               Grid.Column="2" />
                </Grid>

                <!-- 音频频谱：6 个频段，随系统实际播放的声音律动 -->
                <Grid x:Name="SpectrumRow"
                      Margin="0,12,0,0"
                      Height="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="SpecBar0" Grid.Column="0" Width="4" Height="2" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Fill="{DynamicResource Theme.Foreground}" Opacity="0.55" />
                    <Rectangle x:Name="SpecBar1" Grid.Column="1" Width="4" Height="2" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Fill="{DynamicResource Theme.Foreground}" Opacity="0.55" />
                    <Rectangle x:Name="SpecBar2" Grid.Column="2" Width="4" Height="2" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Fill="{DynamicResource Theme.Foreground}" Opacity="0.55" />
                    <Rectangle x:Name="SpecBar3" Grid.Column="3" Width="4" Height="2" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Fill="{DynamicResource Theme.Foreground}" Opacity="0.55" />
                    <Rectangle x:Name="SpecBar4" Grid.Column="4" Width="4" Height="2" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Fill="{DynamicResource Theme.Foreground}" Opacity="0.55" />
                    <Rectangle x:Name="SpecBar5" Grid.Column="5" Width="4" Height="2" RadiusX="2" RadiusY="2"
                               VerticalAlignment="Bottom" HorizontalAlignment="Center"
                               Fill="{DynamicResource Theme.Foreground}" Opacity="0.55" />
                </Grid>

                <!-- 歌词：当前行 / 翻译 / 下一行 -->
                <StackPanel x:Name="LyricsArea"
                            Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="LyricCurrent"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Theme.Foreground}"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="LyricTranslation"
                               FontSize="12"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource Theme.Muted}"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Visibility="Collapsed" />
                    <TextBlock x:Name="LyricNext"
                               FontSize="12"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource Theme.Muted}"
                               TextAlignment="Center"
                               TextWrapping="NoWrap"
                               TextTrimming="CharacterEllipsis"
                               Opacity="0.75" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
