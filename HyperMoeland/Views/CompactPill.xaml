<UserControl x:Class="HyperMoeland.Views.CompactPill"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="RootBorder"
            CornerRadius="23"
            BorderThickness="1"
            Background="{DynamicResource Theme.Overlay}"
            BorderBrush="{DynamicResource Theme.Border}"
            Padding="10,0">
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <!-- 充电指示：紧贴封面左侧，垂直居中 -->
            <Path x:Name="ChargingIcon"
                  Data="M13,2 L5,13 H11 L9,22 L19,9 H12 Z"
                  Fill="#FF00C27A"
                  Width="14"
                  Height="16"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,6,0"
                  RenderTransformOrigin="0.5,0.5"
                  Visibility="Collapsed">
                <Path.RenderTransform>
                    <ScaleTransform x:Name="ChargingScale" ScaleX="1" ScaleY="1" />
                </Path.RenderTransform>
            </Path>
            <!-- 迷你封面：与闪电/文字同一中线 -->
            <Border x:Name="CoverBorder"
                    Width="26"
                    Height="26"
                    CornerRadius="7"
                    Background="{DynamicResource Theme.Border}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0"
                    Visibility="Collapsed">
                <Border.Clip>
                    <RectangleGeometry RadiusX="7" RadiusY="7" Rect="0,0,26,26" />
                </Border.Clip>
                <Image x:Name="CoverImage"
                       Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="ActivityIcon"
                       Text=""
                       FontSize="13"
                       Foreground="{DynamicResource Theme.Foreground}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Foreground}"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="138" />
        </StackPanel>
    </Border>
</UserControl>
