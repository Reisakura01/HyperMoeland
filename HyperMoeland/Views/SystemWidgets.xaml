<UserControl x:Class="HyperMoeland.Views.SystemWidgets"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 系统小组件：CPU / 内存。环形进度 + 标签，随主题色刷新 -->
    <StackPanel x:Name="RootPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Center">
        <!-- CPU -->
        <StackPanel x:Name="CpuWidget" Orientation="Horizontal">
            <Grid Width="32" Height="32">
                <Ellipse Stroke="{DynamicResource Theme.Border}" StrokeThickness="3" />
                <Ellipse x:Name="CpuRing"
                         Stroke="{DynamicResource Theme.Foreground}"
                         StrokeThickness="3"
                         StrokeDashArray="0 28.27"
                         StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="CpuLabel"
                           Text="CPU"
                           FontSize="10"
                           Foreground="{DynamicResource Theme.Muted}" />
                <TextBlock x:Name="CpuValue"
                           Text="--"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Foreground}" />
            </StackPanel>
        </StackPanel>

        <!-- 内存 -->
        <StackPanel x:Name="MemoryWidget" Orientation="Horizontal" Margin="14,0,0,0">
            <Grid Width="32" Height="32">
                <Ellipse Stroke="{DynamicResource Theme.Border}" StrokeThickness="3" />
                <Ellipse x:Name="MemoryRing"
                         Stroke="{DynamicResource Theme.Accent}"
                         StrokeThickness="3"
                         StrokeDashArray="0 28.27"
                         StrokeDashCap="Round"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform Angle="-90" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
            <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="MemoryLabel"
                           Text="内存"
                           FontSize="10"
                           Foreground="{DynamicResource Theme.Muted}" />
                <TextBlock x:Name="MemoryValue"
                           Text="--"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Theme.Foreground}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
