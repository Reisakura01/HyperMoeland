<Window x:Class="Islora.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Islora · 设置"
        Width="420" Height="600"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontSize="13"
        Background="#FFFFFF">
    <Window.Resources>
        <!-- 主题色 -->
        <SolidColorBrush x:Key="Accent" Color="#4F8CFF"/>
        <SolidColorBrush x:Key="Card" Color="#F7F8FA"/>
        <SolidColorBrush x:Key="CardBorder" Color="#ECEEF3"/>
        <SolidColorBrush x:Key="TextStrong" Color="#1B1B1B"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8A8F99"/>

        <!-- 分区卡片 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- 分组标题（带彩色小圆点） -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 卡片分组标题行：圆点 + 文字 -->
        <Style x:Key="GroupHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <!-- 圆角下拉框：自定义现代模板（圆角、矢量箭头、悬停高亮、白色下拉列表） -->
        <Style x:Key="RoundCombo" TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bg" Background="White" CornerRadius="9"
                                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1"/>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Background="Transparent" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="12,0,34,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <!-- 现代下拉箭头 -->
                            <Path Data="M4,6 L10,12 L16,6" Stroke="{StaticResource TextMuted}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" PopupAnimation="Fade" StaysOpen="False">
                                <Border Margin="0,4,0,0" Background="White" CornerRadius="10"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220" Padding="4">
                                    <ScrollViewer>
                                        <StackPanel>
                                            <ItemsPresenter/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 下拉项样式 -->
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBg" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#EDF2FF"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBg" Property="Background" Value="#E3EBFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自定义勾选框：圆角方块 + 选中发光蓝色填充 + 精致对勾 -->
        <Style x:Key="ModernCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextStrong}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <!-- 勾选框（发光层 + 方块叠放） -->
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <!-- 选中外发光 -->
                                <Border x:Name="Glow" CornerRadius="10" Background="{StaticResource Accent}" Opacity="0"/>
                                <!-- 方块 -->
                                <Border x:Name="Box" CornerRadius="7"
                                        Background="White" BorderBrush="#D5DBE6" BorderThickness="1.5">
                                    <!-- 对勾（圆润粗勾） -->
                                    <Path x:Name="Check" Data="M4.5,10.5 C6,11.5 7,13.5 8.5,14.5 C10,12 13,6 15.5,5.5"
                                          Stroke="White" StrokeThickness="2.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed"/>
                                </Border>
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.15"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Box" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 现代滑块：纤细圆润轨道 + 小号圆形手柄 -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="5" CornerRadius="2.5"
                                                        Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="5" CornerRadius="2.5" Background="#E9EBF1"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="16" Height="16">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Grid>
                                                    <Ellipse Width="20" Height="20" Fill="{StaticResource Accent}" Opacity="0.20"/>
                                                    <Ellipse Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                             Stroke="White" StrokeThickness="2.5"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Islora" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextStrong}"/>
                <TextBlock x:Name="SubtitleText" Text="Islora · 设置" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <!-- 内容区（可滚动） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel>

                <!-- 主题 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="10" Height="10" Fill="#FF9F45" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ThemeTitleText" Text="主题" Style="{StaticResource GroupTitle}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="ModeLabel" Text="模式" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ThemeModeBox" Style="{StaticResource RoundCombo}">
                            <ComboBoxItem x:Name="ModeAutoItem" Content="自动（按时间）"/>
                            <ComboBoxItem x:Name="ModeLightItem" Content="强制浅色"/>
                            <ComboBoxItem x:Name="ModeDarkItem" Content="强制深色"/>
                        </ComboBox>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DayStartLabel" Text="日间开始" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="DayStartBox" Style="{StaticResource RoundCombo}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="NightStartLabel" Text="夜间开始" Style="{StaticResource FieldLabel}" Margin="0,0,0,5"/>
                                <ComboBox x:Name="NightStartBox" Style="{StaticResource RoundCombo}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 系统 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Ellipse Width="10" Height="10" Fill="#4F8CFF" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SystemTitleText" Text="系统" Style="{StaticResource GroupTitle}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <CheckBox x:Name="AutoStartCheck" Content="开机自启" Style="{StaticResource ModernCheck}"/>
                        <CheckBox x:Name="AutoUpdateCheck" Content="启动时检查更新" Style="{StaticResource ModernCheck}"/>
                        <CheckBox x:Name="WidgetsCheck" Content="显示 CPU / 内存小组件" Style="{StaticResource ModernCheck}"/>
                        <TextBlock x:Name="LanguageLabel" Text="语言" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="LanguageBox" Style="{StaticResource RoundCombo}">
                            <ComboBoxItem x:Name="LangChineseItem" Content="中文"/>
                            <ComboBoxItem x:Name="LangEnglishItem" Content="English"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 霓虹 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10" Fill="#8B5CF6" VerticalAlignment="Center"/>
                            <TextBlock x:Name="NeonTitleText" Text="霓虹动画" Style="{StaticResource GroupTitle}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="NeonHintText" Text="卡片霓虹背景的节拍快慢，播放音乐时生效" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                        <DockPanel Margin="0,12,0,0" Height="22">
                            <TextBlock x:Name="NeonSpeedLabel"
                                       DockPanel.Dock="Right"
                                       Width="54"
                                       Foreground="{StaticResource TextStrong}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       TextAlignment="Right"
                                       VerticalAlignment="Center"/>
                            <Slider x:Name="NeonSpeedSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="400"
                                    Maximum="2000"
                                    TickFrequency="100"
                                    ValueChanged="OnNeonSpeedChanged"
                                    SmallChange="50"
                                    LargeChange="100"
                                    VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="90" Height="36" Margin="0,0,10,0" Click="OnCancel"
                    Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Foreground="{StaticResource TextStrong}"
                    Cursor="Hand" FontSize="13"/>
            <Button x:Name="SaveButton" Content="保存" Width="90" Height="36" IsDefault="True" Click="OnSave"
                    Background="{StaticResource Accent}" Foreground="White" BorderThickness="0"
                    Cursor="Hand" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
